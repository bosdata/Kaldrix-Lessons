": 26, "week": 6, "level": "Advanced", "title": "Power BI Data Modeling", "tool": "Power BI", "concepts": "Fact/dimension design, relationships and star-schema thinking.", "objectives": ["Identify fact vs dimension tables", "Create relationships", "Avoid many-to-many mistakes"], "practical": "Model transactions, people, calendar and program tables.", "ai_use": "Describe your proposed model to AI and ask it to identify relationship risks; validate in Model view.", "exercise": "Create a simple star schema.", "capstone": false}, {"day": 27, "week": 6, "level": "Advanced", "title": "DAX Measures & Filter Context", "tool": "Power BI / DAX", "concepts": "Measures vs columns, CALCULATE and filter context.", "objectives": ["Create measures", "Use DIVIDE", "Understand filter context"], "practical": "Build Total Actual, Total Target, Achievement %, Distinct People and YTD measures.", "ai_use": "Ask AI to explain your DAX measure line-by-line; then test it under slicers.", "exercise": "Create validated KPI measures.", "capstone": false}, {"day": 28, "week": 6, "level": "Advanced", "title": "Statistics for Analysts", "tool": "Statistics", "concepts": "Distribution, variance, standard deviation, outliers, correlation and sampling caution.", "objectives": ["Interpret spread", "Detect outliers", "Distinguish correlation from causation"], "practical": "Analyze a numeric dataset, compare mean/median, inspect outliers and calculate correlation.", "ai_use": "Ask AI for alternative explanations for an observed correlation.", "exercise": "Perform an exploratory statistical analysis.", "capstone": false}, {"day": 29, "week": 6, "level": "Advanced", "title": "Dashboard Design & Data Storytelling", "tool": "Power BI / Sheets", "concepts": "Decision-focused visuals, hierarchy, accessibility and narrative.", "objectives": ["Choose visuals intentionally", "Reduce clutter", "Write management findings"], "practical": "Redesign a cluttered dashboard brief into one executive page plus one diagnostic page.", "ai_use": "Ask AI to critique the dashboard from the perspective of a busy manager.", "exercise": "Build a decision-focused dashboard.", "capstone": false}, {"day": 30, "week": 6, "level": "Advanced", "title": "Advanced Capstone", "tool": "SQL + Power BI", "concepts": "From raw relational data to SQL analysis, Power BI model, measures, dashboard and QA.", "objectives": ["Integrate SQL and BI", "Build validated measures", "Present findings"], "practical": "Complete an end-to-end program performance analysis with source reconciliation.", "ai_use": "Use AI as reviewer: request five audit questions and answer them from your model.", "exercise": "Advanced capstone: SQL-to-dashboard analysis.", "capstone": true}, {"day": 31, "week": 7, "level": "Pro", "title": "Python & pandas Foundations", "tool": "Python / pandas", "concepts": "DataFrames, columns, filtering, selecting, basic summaries and reproducibility.", "objectives": ["Load CSV/XLSX", "Inspect DataFrame", "Filter/select", "Calculate summaries"], "practical": "Load an exercise dataset with pandas and reproduce key summaries previously done in Sheets.", "ai_use": "Ask AI to explain code you wrote, not to generate an entire notebook from scratch.", "exercise": "Reproduce spreadsheet analysis in pandas.", "capstone": false}, {"day": 32, "week": 7, "level": "Pro", "title": "pandas Cleaning & Missing Data", "tool": "Python / pandas", "concepts": "String cleaning, types, missing values, duplicates and validation.", "objectives": ["Use .str methods", "Handle NaN deliberately", "Remove justified duplicates", "Validate ranges"], "practical": "Clean a messy operational dataset and create a quality report.", "ai_use": "Ask AI to propose tests for your cleaning rules; implement and inspect the tests yourself.", "exercise": "Build a reproducible pandas cleaning pipeline.", "capstone": false}, {"day": 33, "week": 7, "level": "Pro", "title": "pandas Merge, GroupBy & Pivot", "tool": "Python / pandas", "concepts": "Combining tables and producing analytical summaries.", "objectives": ["merge tables", "groupby/agg", "pivot_table", "detect unmatched keys"], "practical": "Merge people and activity tables, summarize by county/program and surface unmatched keys.", "ai_use": "Ask AI to review your merge cardinality assumptions.", "exercise": "Create an integrated pandas analysis.", "capstone": false}, {"day": 34, "week": 7, "level": "Pro", "title": "Python Visualization", "tool": "Python / matplotlib", "concepts": "Clear analytical plots and avoiding misleading visuals.", "objectives": ["Create bar/line/scatter plots", "Label plots", "Choose appropriate visual"], "practical": "Create four plots answering specified questions, each on its own figure.", "ai_use": "Ask AI to critique the interpretation, not merely the aesthetics.", "exercise": "Produce an analytical visualization pack.", "capstone": false}, {"day": 35, "week": 7, "level": "Pro", "title": "Exploratory Data Analysis & Anomaly Detection", "tool": "Python / Statistics", "concepts": "Systematic profiling, distributions, segment comparisons and anomaly investigation.", "objectives": ["Profile data", "Compare segments", "Flag anomalies", "Distinguish anomaly from error"], "practical": "Create an EDA report and investigate the top five anomalies.", "ai_use": "Ask AI for plausible hypotheses, then label them explicitly as hypotheses until verified.", "exercise": "Perform structured EDA and anomaly investigation.", "capstone": false}, {"day": 36, "week": 8, "level": "Pro", "title": "Automation & Reproducible Reporting", "tool": "Python", "concepts": "Functions, configuration, file outputs, logging and repeatable refresh.", "objectives": ["Write reusable functions", "Separate configuration", "Generate outputs automatically"], "practical": "Turn a manual analysis into a script that reads raw files and writes cleaned data plus a summary.", "ai_use": "Ask AI to review code organization and suggest tests, not business assumptions.", "exercise": "Automate a recurring analysis.", "capstone": false}, {"day": 37, "week": 8, "level": "Pro", "title": "Experimentation & A/B Test Thinking", "tool": "Statistics / Python", "concepts": "Hypotheses, treatment/control, effect size, uncertainty and common pitfalls.", "objectives": ["Formulate H0/H1", "Calculate group metrics", "Interpret uncertainty", "Avoid p-value misuse"], "practical": "Analyze a synthetic intervention dataset and write a cautious decision memo.", "ai_use": "Ask AI to argue against your conclusion and identify threats to validity.", "exercise": "Evaluate a simple experiment.", "capstone": false}, {"day": 38, "week": 8, "level": "Pro", "title": "Forecasting Fundamentals & Limits", "tool": "Python / Analytics", "concepts": "Time-series structure, baseline forecasts, seasonality and uncertainty.", "objectives": ["Create a baseline forecast", "Use train/test split", "Compare forecast error", "State limitations"], "practical": "Build a moving-average or simple trend bas