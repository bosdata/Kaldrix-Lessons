<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Kaldrix Data Analysis Mastery Programme</title>
<style>
:root{--paper:#f7f5f1;--ink:#172232;--muted:#6b7280;--line:#d9dee5;--blue:#1678b8;--blue2:#0f5f96;--soft:#edf5fa;--green:#2f7b4b;--greenbg:#edf8f0;--gold:#a77922;--goldbg:#fff7e5;--red:#a34141;--redbg:#fff0f0;--card:#fff}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:"Segoe UI",Arial,sans-serif}
button,input,textarea{font:inherit}button{cursor:pointer}
.topline{height:5px;background:#111}
header{background:#fff;border-bottom:1px solid var(--line)}.mast{max-width:1320px;margin:auto;padding:26px 30px 20px;display:flex;justify-content:space-between;gap:30px;align-items:flex-end}
.brand img{height:64px;display:block}.brand small{display:block;color:#707988;margin-top:8px;font-size:12px;letter-spacing:.04em}
.program{text-align:right}.program h1{font-family:Georgia,"Times New Roman",serif;font-weight:500;margin:0;font-size:34px;letter-spacing:-.02em}.program p{margin:7px 0 0;color:var(--muted);font-size:14px}
.profilebar{background:#f0f4f7;border-bottom:1px solid var(--line)}.profileinner{max-width:1320px;margin:auto;padding:13px 30px;display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.profileinner label{font-size:12px;color:#586474;font-weight:700}.profileinner input{border:1px solid #cbd3db;background:#fff;padding:8px 10px;border-radius:6px;min-width:250px}
.progwrap{margin-left:auto;min-width:300px}.progline{height:7px;background:#dde4ea;border-radius:99px;overflow:hidden}.progline span{display:block;height:100%;width:0;background:var(--blue)}.progtext{font-size:12px;color:#596575;margin-top:5px;text-align:right}
main{max-width:1320px;margin:auto;padding:26px 30px 90px}.intro{display:grid;grid-template-columns:1.25fr .75fr;gap:22px;margin-bottom:25px}.introbox{background:#fff;border:1px solid var(--line);padding:22px;border-radius:10px}.introbox h2{font-family:Georgia,serif;font-weight:500;margin:0 0 8px;font-size:25px}.introbox p{color:#5f6976;line-height:1.6;margin:0}
.quick{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.quick button{border:1px solid #cbd4dc;background:#fff;border-radius:7px;padding:10px;text-align:left;color:#263445;font-weight:650}.quick button:hover{border-color:var(--blue);color:var(--blue2)}
.tabs{display:flex;gap:0;border-bottom:1px solid var(--line);margin:28px 0 20px;overflow:auto}.tab{border:0;background:none;padding:13px 18px;color:#697482;font-weight:700;border-bottom:3px solid transparent;white-space:nowrap}.tab.active{color:var(--blue2);border-bottom-color:var(--blue)}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px}.stat{background:#fff;border:1px solid var(--line);border-radius:8px;padding:15px}.stat strong{display:block;font-family:Georgia,serif;font-size:25px;font-weight:500}.stat span{font-size:12px;color:#77808b}
.levelhead{display:flex;justify-content:space-between;gap:20px;align-items:flex-end;margin:18px 0 12px}.levelhead h2{font-family:Georgia,serif;font-weight:500;font-size:30px;margin:0}.levelhead p{max-width:720px;color:#68727e;margin:5px 0 0;line-height:1.5}
.certificateState{padding:8px 11px;border-radius:6px;background:#eef1f4;color:#66717e;font-size:12px;font-weight:700}.certificateState.ready{background:var(--goldbg);color:#7a5618;border:1px solid #ead29f}
.lessonlist{display:flex;flex-direction:column;gap:10px}.lesson{background:#fff;border:1px solid var(--line);border-radius:9px;overflow:hidden}.lesson.approved{border-left:4px solid var(--green)}.lesson.submitted{border-left:4px solid var(--gold)}.lesson.completed{border-left:4px solid var(--blue)}.lessonTop{display:grid;grid-template-columns:64px 1fr auto;gap:15px;align-items:center;padding:16px}
.daynum{font-family:Georgia,serif;font-size:24px;color:#53606e;text-align:center}.lessonTitle h3{margin:0;font-size:16px}.lessonTitle p{margin:5px 0 0;color:#737d88;font-size:13px}.status{font-size:11px;font-weight:800;padding:6px 8px;border-radius:5px;background:#eef1f4;color:#67717d;white-space:nowrap}.status.submitted{background:var(--goldbg);color:#805a16}.status.approved{background:var(--greenbg);color:#28623d}.status.completed{background:#e8f3fb;color:#0f5f96}
.lessonBody{border-top:1px solid #edf0f2;padding:14px 16px 16px;display:grid;grid-template-columns:1fr 1fr;gap:14px}.actions{display:flex;gap:7px;flex-wrap:wrap}.btn{border:1px solid #c6d0d8;background:#fff;color:#2b3947;border-radius:6px;padding:8px 10px;font-size:12px;font-weight:700}.btn.primary{background:var(--blue);border-color:var(--blue);color:#fff}.btn:hover{filter:brightness(.98)}.submission{background:#f8fafb;border:1px solid #e1e6ea;border-radius:7px;padding:12px}.submission label{display:block;font-size:11px;color:#657180;font-weight:800;margin-bottom:6px}.linkrow{display:flex;gap:7px}.linkrow input{flex:1;border:1px solid #ccd5dd;border-radius:6px;padding:8px;font-size:12px}.feedback{margin-top:8px;color:#687482;font-size:12px}.donecheck{margin-top:10px;padding-top:10px;border-top:1px solid #dde4e9;display:flex;align-items:flex-start;gap:8px;font-size:12px;color:#4f5c68}.donecheck input{margin-top:2px;width:16px;height:16px}.donecheck.locked{color:#929aa3}.datasetHelp{margin-top:7px;font-size:11px;color:#79838d}.trainerApprove{margin-top:9px;padding-top:9px;border-top:1px dashed #d6dde3;display:none}body.trainer .trainerApprove{display:flex;gap:7px;align-items:center;flex-wrap:wrap}
.tools{margin-top:32px;border-top:1px solid var(--line);padding-top:24px}.tools h2{font-family:Georgia,serif;font-weight:500}.aiCoach{display:grid;grid-template-columns:minmax(300px,.9fr) minmax(360px,1.1fr);gap:14px;margin:16px 0 22px}.aiComposer,.aiPreview{background:#fff;border:1px solid var(--line);border-radius:9px;padding:15px}.aiLabel{display:block;font-size:11px;font-weight:800;color:#596675;margin:0 0 6px}.aiControl,.aiText,.aiPromptPreview{width:100%;border:1px solid #cbd4dc;background:#fff;color:var(--ink);border-radius:6px;padding:9px 10px}.aiControl{margin-bottom:12px}.aiText{min-height:122px;resize:vertical;margin-bottom:10px;line-height:1.5}.aiPreview{display:flex;flex-direction:column}.aiPreviewHead{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;margin-bottom:9px}.aiPreviewHead span{max-width:60%;font-size:10px;color:#7a8490;text-align:right;line-height:1.4}.aiPromptPreview{flex:1;min-height:268px;resize:vertical;background:#fafbfc;line-height:1.5;font-family:"Segoe UI",Arial,sans-serif;font-size:12px}.aiStatus{min-height:18px;margin-top:8px;font-size:12px;color:#356b49}.aiStatus.error{color:#a34141}.aiQuickTitle{font-family:Georgia,serif;font-weight:500;margin:4px 0 10px}.aiGrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px}.aiCard{background:#fff;border:1px solid var(--line);border-radius:8px;padding:13px}.aiCard strong{font-size: