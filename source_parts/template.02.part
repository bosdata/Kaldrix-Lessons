13px}.aiCard p{color:#66717d;font-size:12px;line-height:1.45;margin:7px 0 10px}.aiCard .btn{margin-right:5px}.aiCard.active{border-color:var(--blue);box-shadow:0 0 0 2px #1678b81a}
.modal{position:fixed;inset:0;background:#1119;display:none;align-items:center;justify-content:center;padding:20px;z-index:100}.modal.show{display:flex}.modalbox{background:#fff;border-radius:10px;width:min(960px,96vw);max-height:92vh;overflow:auto;padding:24px;box-shadow:0 20px 60px #0004}.close{float:right;border:1px solid #cfd7df;background:#fff;border-radius:6px;padding:7px 9px}
.cert{border:12px double #1f344a;padding:42px;text-align:center;background:#fff;min-height:650px;position:relative}.cert img{height:70px;margin-bottom:20px}.cert h1{font-family:Georgia,serif;font-size:42px;font-weight:500;margin:12px 0 4px}.cert .subtitle{letter-spacing:.18em;font-size:11px;color:#5d6873}.cert .name{font-family:Georgia,serif;font-size:34px;margin:30px 0 10px;border-bottom:1px solid #9fa9b2;display:inline-block;padding:0 35px 7px}.cert p{font-size:15px;line-height:1.7;color:#424d59}.cert .level{font-family:Georgia,serif;font-size:25px;color:#0f5f96}.certfoot{display:flex;justify-content:space-between;gap:40px;margin-top:60px}.sign{flex:1;border-top:1px solid #818b95;padding-top:8px;font-size:12px}.certnote{font-size:10px;color:#7a848e;margin-top:30px}
.trainerpanel{background:#fff;border:1px solid var(--line);border-radius:9px;padding:16px;margin-bottom:18px;display:none}body.trainer .trainerpanel{display:block}.trainerpanel h3{margin-top:0}.trainerTag{display:none;color:#27653e;background:var(--greenbg);border:1px solid #cbe8d4;border-radius:6px;padding:7px 10px;font-size:12px;font-weight:800}body.trainer .trainerTag{display:inline-block}.trainerOnly{display:none}body.trainerApp .trainerOnly{display:block}
footer{border-top:1px solid var(--line);padding:25px;text-align:center;color:#7a848f;font-size:12px;background:#fff}
@media(max-width:850px){.aiCoach{grid-template-columns:1fr}.aiPreviewHead{flex-direction:column}.aiPreviewHead span{max-width:100%;text-align:left}.mast{flex-direction:column;align-items:flex-start}.program{text-align:left}.intro{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}.lessonTop{grid-template-columns:50px 1fr}.status{grid-column:2}.lessonBody{grid-template-columns:1fr}.progwrap{width:100%;margin-left:0}}
@media print{body>*:not(.modal){display:none!important}.modal{position:static;display:block!important;background:white;padding:0}.modalbox{box-shadow:none;max-height:none;width:100%;padding:0}.close,.printHide{display:none!important}.cert{page-break-inside:avoid}}
</style>
</head>
<body>
<div class="topline"></div>
<header><div class="mast"><div class="brand"><img src="__LOGO_DATA__" alt="Kaldrix logo"><small>Built by Kaldrix Limited · Data & Technology Learning Programme</small></div><div class="program"><h1>Data Analysis Mastery</h1><p>Absolute Beginner → Intermediate → Advanced → Pro → Expert</p></div></div></header>
<div class="profilebar"><div class="profileinner"><label>Official learner name</label><input id="learnerName" placeholder="Use the name that should appear on certificates"><span id="trainerTag" class="trainerTag">Trainer Mode</span><div class="progwrap"><div class="progline"><span id="globalBar"></span></div><div class="progtext" id="globalText">0 / 50 lessons trainer-approved</div></div></div></div>

<main>
<section class="intro"><div class="introbox"><h2>Learn the work. Prove the work.</h2><p>This programme is designed around real analytical capability rather than completion clicks. Learners study the lesson, perform the practical work in Google Sheets or the relevant analysis tool, submit evidence, and progress only after trainer approval. Higher levels introduce SQL, Power BI, statistics, Python, automation, governance, communication and disciplined use of AI.</p></div>
<div class="introbox"><div class="quick"><button onclick="downloadData(MASTER,'Kaldrix_Data_Analysis_Mastery_Roadmap.pdf')">Full roadmap PDF</button><button onclick="openGoogleSheets()">Create Google Sheet</button><button class="trainerOnly" onclick="trainerLogin()">Trainer Mode</button><button onclick="exportRecord()">Export course record</button><button onclick="document.getElementById('recordImport').click()">Import course record</button><input id="recordImport" type="file" accept=".json,application/json" style="display:none" onchange="importRecord(this)"></div></div></section>

<div class="trainerpanel"><h3>Trainer controls</h3><p>You are reviewing this browser's learner record. Open submitted Google Sheets, review the work, then approve or return the lesson. Certificates use the date of the final approval in each level.</p><button class="btn" onclick="trainerLogout()">Exit Trainer Mode</button></div>

<nav class="tabs" id="tabs"></nav>
<div class="stats"><div class="stat"><strong id="approvedStat">0/10</strong><span>trainer-approved in this level</span></div><div class="stat"><strong id="submittedStat">0/10</strong><span>learner-marked done</span></div><div class="stat"><strong id="levelPct">0%</strong><span>completed progress</span></div><div class="stat"><strong id="capstoneStat">Not approved</strong><span>level capstone</span></div></div>
<section id="course"></section>

<section class="tools" id="aiLab"><h2>AI Learning Lab</h2><p style="color:#68727e">Use AI as a tutor, debugger, reviewer and mock assessor. Choose the lesson, tell the coach what you are working on, then the app builds a lesson-aware prompt. The prompt is copied reliably even when this HTML is opened locally, and ChatGPT opens in a new tab for the learner to continue.</p><div class="aiCoach"><div class="aiComposer"><label class="aiLabel" for="aiLesson">Lesson</label><select id="aiLesson" class="aiControl"></select><label class="aiLabel" for="aiMode">How should AI help?</label><select id="aiMode" class="aiControl"></select><label class="aiLabel" for="aiInput">Your attempt, question or difficulty</label><textarea id="aiInput" class="aiText" placeholder="Example: I tried =AVERAGE(E2:E20), but I am not sure whether blanks affect the result. Please guide me without solving the whole exercise."></textarea><div class="actions"><button class="btn primary" onclick="buildAIPrompt(true)">Build coaching prompt</button><button class="btn" onclick="copyAndOpenChatGPT()">Copy &amp; Open ChatGPT</button><button class="btn" onclick="copyBuiltPrompt()">Copy prompt</button><button class="btn" onclick="clearAICoach()">Clear</button></div><div id="aiStatus" class="aiStatus" aria-live="polite"></div></div><div class="aiPreview"><div class="aiPreviewHead"><strong>Prepared prompt</strong><span>Never paste confidential or personal data unless Kaldrix has approved that use.</span></div><textarea id="aiPromptPreview" class="aiPromptPreview" readonly placeholder="Your lesson-aware coaching prompt will appear here."></textarea></div></div><h3 class="aiQuickTitle">Quick coaching modes</h3><div class="aiGrid" id="aiGrid