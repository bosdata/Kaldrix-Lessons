[{"day": 1, "week": 1, "level": "Beginner", "title": "Spreadsheet Anatomy & Data Types", "tool": "Google Sheets", "concepts": "Rows, columns, cells, ranges, text, numbers, dates, percentages and why data types matter.", "objectives": ["Identify cells and ranges correctly", "Recognize common data types", "Enter and format a clean table"], "practical": "Create a 20-row participant table, format headers, freeze row 1, and identify numeric vs text fields.", "ai_use": "Ask AI to explain a concept using your own small example. Do not ask it to complete the exercise.", "exercise": "Build and format a small participant register.", "capstone": false}, {"day": 2, "week": 1, "level": "Beginner", "title": "SUM, AVERAGE, MEDIAN, MIN, MAX & COUNT", "tool": "Google Sheets", "concepts": "Basic descriptive statistics and the difference between average and median.", "objectives": ["Write basic formulas", "Choose the right summary statistic", "Check whether a result is reasonable"], "practical": "Calculate score summaries from a participant test table and change source values to confirm formulas update.", "ai_use": "Ask AI: 'Explain why mean and median may differ. Give me a new example, but do not solve my dataset.'", "exercise": "Summarize test scores and explain mean vs median.", "capstone": false}, {"day": 3, "week": 1, "level": "Beginner", "title": "Percentages & Relative References", "tool": "Google Sheets", "concepts": "Part/whole percentages, percentage formatting and formula copying.", "objectives": ["Calculate percentages", "Copy formulas safely", "Recognize relative references"], "practical": "Calculate attendance percentage from sessions attended / total sessions and fill the formula down.", "ai_use": "Ask AI to check your formula structure, not the final values.", "exercise": "Calculate attendance and completion percentages.", "capstone": false}, {"day": 4, "week": 1, "level": "Beginner", "title": "IF Logic for Data Classification", "tool": "Google Sheets", "concepts": "Boolean thinking: condition, result if true, result if false.", "objectives": ["Create a simple IF", "Translate a written rule into logic", "Test boundary values"], "practical": "Classify learners as Pass/Fail and Eligible/Not Eligible using stated thresholds.", "ai_use": "Give AI the business rule and your formula; ask it to critique the logic and test edge cases.", "exercise": "Create rule-based status fields.", "capstone": false}, {"day": 5, "week": 1, "level": "Beginner", "title": "Sort, Filter & Conditional Formatting", "tool": "Google Sheets", "concepts": "Inspecting subsets without deleting data and visually flagging values.", "objectives": ["Sort correctly", "Filter categories", "Apply meaningful conditional formatting"], "practical": "Filter one county, sort scores high-to-low and highlight low performance.", "ai_use": "Ask AI for three questions you could answer with the current table; choose one and answer it yourself.", "exercise": "Find top/bottom performers and filtered groups.", "capstone": false}, {"day": 6, "week": 2, "level": "Beginner", "title": "COUNTIF, SUMIF & AVERAGEIF", "tool": "Google Sheets", "concepts": "One-condition summaries by category.", "objectives": ["Count by category", "Sum by category", "Calculate category averages"], "practical": "Create county and product summaries using one-condition functions.", "ai_use": "Ask AI to explain the difference between COUNTIF, SUMIF and AVERAGEIF in plain language.", "exercise": "Build a category summary table.", "capstone": false}, {"day": 7, "week": 2, "level": "Beginner", "title": "Text Cleaning: TRIM, PROPER & Standardization", "tool": "Google Sheets", "concepts": "Why visually similar text can be analytically different.", "objectives": ["Remove unwanted spaces", "Standardize capitalization", "Preserve raw data while cleaning"], "practical": "Duplicate the raw sheet, standardize names/counties and compare category counts before vs after.", "ai_use": "Ask AI for a checklist of text-quality problems to inspect; do the cleaning yourself.", "exercise": "Clean a messy participant register.", "capstone": false}, {"day": 8, "week": 2, "level": "Beginner", "title": "Dates, Missing Values & Duplicates", "tool": "Google Sheets", "concepts": "Dates as values, blanks vs zero, duplicate detection and documentation.", "objectives": ["Identify missing values", "Detect duplicates", "Standardize dates", "Document cleaning decisions"], "practical": "Create a small data-quality log showing issue type, count, decision and affected field.", "ai_use": "Ask AI to challenge your cleaning decision: 'What could go wrong if I replace blanks with zero?'", "exercise": "Audit and clean a registration dataset.", "capstone": false}, {"day": 9, "week": 2, "level": "Beginner", "title": "Charts & Evidence-Based Findings", "tool": "Google Sheets", "concepts": "Choosing a chart for comparison, trend or composition and writing findings from evidence.", "objectives": ["Create a clear chart", "Use meaningful titles", "Write findings supported by numbers"], "practical": "Build a county comparison chart and a simple score distribution chart; write four findings.", "ai_use": "Ask AI to critique whether each finding is actually supported by the data.", "exercise": "Create charts and evidence-based findings.", "capstone": false}, {"day": 10, "week": 2, "level": "Beginner", "title": "Beginner Capstone: One-Table Analysis", "tool": "Google Sheets", "concepts": "End-to-end beginner workflow: understand, clean, calculate, summarize, visualize, check and explain.", "objectives": ["Complete a small analysis independently", "Reconcile totals", "Present concise findings"], "practical": "Analyze a community training dataset from raw records to management summary.", "ai_use": "After completing the project, ask AI to act as an assessor and question your choices; do not let it rewrite your workbook.", "exercise": "Beginner capstone: training performance report.", "capstone": true}, {"day": 11, "week": 3, "level": "Intermediate", "title": "Absolute References, AND & OR", "tool": "Google Sheets", "concepts": "Fixed rule cells and combining multiple conditions.", "objectives": ["Use $ references correctly", "Combine conditions with AND/OR", "Centralize thresholds"], "practical": "Store thresholds in a Rules area and build qualification/priority statuses.", "ai_use": "Ask AI to generate edge cases that could break your rule.", "exercise": "Build a reusable staff eligibility model.", "capstone": false}, {"day": 12, "week": 3, "level": "Intermediate", "title": "COUNTIFS, SUMIFS & AVERAGEIFS", "tool": "Google Sheets", "concepts": "Multiple simultaneous conditions across text, numbers and dates.", "objectives": ["Apply multi-condition summaries", "Use date criteria", "Validate aligned ranges"], "practical": "Summarize participants and cost by county, program, gender and period.", "ai_use": "Ask AI to inspect your criteria logic and point out mismatched-range risks.", "exercise": "Create a multi-condi